<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PblMauiShipment.View.RackRegister"
             Title="RackRegister"
             xmlns:local="clr-namespace:PblMauiShipment"
             xmlns:model="clr-namespace:PblMauiShipment.Models"
             xmlns:viewmodel="clr-namespace:PblMauiShipment.ViewModels"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI"
             x:DataType="viewmodel:RackScanRegisterViewModel">
    <Grid ColumnDefinitions="*,*,Auto"
          ColumnSpacing="0"
          RowDefinitions="Auto,*,*,Auto,Auto"
          RowSpacing="0">
        <Entry x:Name="barcode_register"
               Placeholder="Barcode"
               Grid.Row="0"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               HeightRequest="50"
               FontSize="Large"
               Completed="barcode_register_Completed"/>
        <Label x:Name="scannedCountRegister" 
               Text="{Binding RackScannsRegister.Count}"
               Grid.Column="2"
               HeightRequest="30"
               WidthRequest="150"
               VerticalOptions="Center"              
               Style="{StaticResource LargeLabel}"
               HorizontalTextAlignment="Center"
               />
        <ScrollView HorizontalOptions="CenterAndExpand"
                    VerticalOptions="StartAndExpand"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.RowSpan="2">
            <CollectionView ItemsSource="{Binding RackScannsRegister}"
                            SelectionMode="None"
                            VerticalOptions="StartAndExpand">
                <CollectionView.EmptyView>
                    <Label Text="Keine Scann's vorhanden!"></Label>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:RackScan">
                        <Grid ColumnDefinitions="Auto,*,*"
                              ColumnSpacing="5">
                            <Label HeightRequest="30" Grid.Column="0" Text="{Binding Barcode}" FontSize="Large"></Label>
                            <!--<Label HeightRequest="20" Grid.Column="1" Text="{Binding Scanned}"></Label>
                            <Label HeightRequest="20" Grid.Column="2" Text="{Binding ItemID}"></Label>-->
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>
        <Button Text="Scann"
                Command="{Binding ScanBarcodeRegisterCommand}"
                Grid.Row="1"
                Grid.Column="2"
                Style="{StaticResource ButtonOutline}"/>
        <Button Text="Send"
                Command="{Binding SendFileRegisterCommand}"
                Grid.Row="2"
                Grid.Column="2"
                Style="{StaticResource ButtonOutline}"/>
        <Label x:Name="filesToSendRegisterDesc" 
               Text="{Binding FilesToSendRegister}"
               Grid.Column="1"
               Grid.Row="4"
               HeightRequest="30"
               VerticalOptions="Center"    
               HorizontalOptions="Start"
               FontSize="Large"
               />
        <Label x:Name="filesToSendRegister" 
               Text="Dateien noch nicht hochgeladen:   "
               Grid.Column="0"
               Grid.Row="4"
               HeightRequest="30"
               VerticalOptions="Center"    
               HorizontalOptions="EndAndExpand"
               FontSize="Large"
               />
        <Label x:Name="lightSwitchRegister" 
               Text="Licht   "
               Grid.Column="0"
               Grid.Row="3"
               HeightRequest="30"
               VerticalOptions="Center"    
               HorizontalOptions="EndAndExpand"
               FontSize="Large"
               />
        <Switch IsToggled="true"
                x:Name="FlashlightSwitchRegister"               
                Grid.Row="3"
                Grid.Column="1"
                HorizontalOptions="Start"
                OnColor="Orange"
                ThumbColor="Green"
                Toggled="FlashlightSwitchRegister_Toggled"
                />
    </Grid>
</ContentPage>