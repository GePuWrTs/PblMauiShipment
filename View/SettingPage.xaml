<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PblMauiShipment.View.SettingPage"
             Title="SettingPage">
    <Grid ColumnDefinitions="*"
          ColumnSpacing="0"
          RowDefinitions="Auto,Auto"
          RowSpacing="0">
        <Label x:Name="server_uri_label" 
               Text="Server URI:"
               Grid.Row="0"
               Grid.Column="0"
               HeightRequest="30"
               VerticalOptions="End"              
               Style="{StaticResource LargeLabel}"
               HorizontalTextAlignment="Center"
               />
        <Entry x:Name="server_uri"
               Placeholder="Server Uri"
               Grid.Row="1"
               Grid.Column="0"
               HeightRequest="50"
               FontSize="Large"
               TextChanged="server_uri_TextChanged"
               />
    </Grid>
</ContentPage>